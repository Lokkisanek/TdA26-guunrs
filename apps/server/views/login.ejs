<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Přihlášení - Think different Academy</title>
  <link rel="stylesheet" href="/css/common.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    /* Background like homepage */
    body { font-family: 'Dosis', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: var(--brand-primary); min-height: 100vh; display: flex; flex-direction: column; }
    /* Centering wrapper so footer stays at page bottom */
    .main { flex: 1; display: flex; align-items: center; justify-content: center; padding: 2rem 0; }
    /* Flat card similar to courses; taller and fully square corners */
    .login-container { background: #ffffff; padding: 3rem 2.25rem; border-radius: 0; box-shadow: none; width: 100%; max-width: 460px; border-top: 6px solid var(--brand-blue-dark); }
    .login-container h1 { text-align: center; color: var(--brand-blue-dark); margin-bottom: 1.25rem; font-size: 1.6rem; }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; margin-bottom: 0.4rem; color: #555; font-weight: 600; }
    .form-group input { width: 100%; padding: 0.9rem; border: 1px solid rgba(0,0,0,0.06); border-radius: 0; font-size: 1rem; background: #fff; }
    .form-group input:focus { outline: none; border-color: var(--brand-blue-dark); box-shadow: none; }
    .btn { width: 100%; padding: 1rem; background: var(--brand-primary); color: white; border: 2px solid rgba(0,0,0,0.06); border-radius: 0; font-size: 1rem; font-weight: 700; cursor: pointer; transition: filter 0.12s ease, transform 0.12s ease; }
    .btn:hover { filter: brightness(1.04); }
    .error { background: #fee; color: #c00; padding: 0.75rem; border-radius: 0; margin-bottom: 1rem; text-align: center; }
    .back-link { display: block; text-align: center; margin-top: 1.25rem; color: var(--brand-blue-dark); text-decoration: none; }
    .back-link:hover { text-decoration: underline; }
    @media (max-width: 480px) { .login-container { padding: 1rem; margin: 1rem; } }
  </style>
</head>
<body>
  <main class="main">
    <div class="login-container">
    <h1>Přihlášení</h1>
    
    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    
    <form method="POST" action="/login">
      <div class="form-group">
        <label for="username">Uživatelské jméno</label>
        <input type="text" id="username" name="username" required>
      </div>
      <div class="form-group">
        <label for="password">Heslo</label>
        <input type="password" id="password" name="password" required>
      </div>
      <button type="submit" class="btn">Přihlásit se</button>
    </form>
    
    <a href="/" class="back-link">← Zpět na hlavní stránku</a>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Správa kurzu - <%= course.name %></title>
  <link rel="stylesheet" href="/css/common.css">
  <style>
    .container { max-width: 1000px; margin: 0 auto; padding: 2rem; }
    h1 { color: #333; margin-bottom: 0.5rem; }
    .subtitle { color: #666; margin-bottom: 2rem; }
    .back-link { display: inline-block; margin-bottom: 1.5rem; color: #667eea; text-decoration: none; }
    .back-link:hover { text-decoration: underline; }
    .card { background: white; border-radius: 0; padding: 1.5rem; box-shadow: none; margin-bottom: 2rem; border-top: 6px solid var(--brand-primary); }
    .card h2 { color: #333; margin-bottom: 1rem; font-size: 1.3rem; border-bottom: 2px solid var(--brand-primary); padding-bottom: 0.5rem; }
    .form-row { display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; }
    .form-group { flex: 1; min-width: 200px; }
    .form-group label { display: block; margin-bottom: 0.5rem; color: #555; font-weight: 500; }
    .form-group input, .form-group textarea, .form-group select { width: 100%; padding: 0.75rem; border: 1px solid rgba(0,0,0,0.06); border-radius: 0; font-size: 1rem; background: #fff; }
    .form-group textarea { resize: vertical; min-height: 80px; }
    .btn { padding: 0.75rem 1.5rem; background: var(--brand-primary); color: white; border: 2px solid rgba(0,0,0,0.06); border-radius: 0; cursor: pointer; font-size: 1rem; font-weight: 700; }
    .btn:hover { filter: brightness(0.98); }
    .btn-danger { background: #dc3545; border-color: rgba(0,0,0,0.06); border-radius: 0; }
    .btn-danger:hover { filter: brightness(0.96); }
    .btn-secondary { background: #6c757d; border-color: rgba(0,0,0,0.06); border-radius: 0; }
    .btn-secondary:hover { filter: brightness(0.96); }
    .btn-sm { padding: 0.4rem 0.8rem; font-size: 0.875rem; }
    .materials-list { list-style: none; }
    .material-item { display: flex; align-items: center; padding: 1rem; background: #fff; border-radius: 0; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem; border: 1px solid rgba(0,0,0,0.06); }
    .material-icon { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: var(--brand-primary); color: white; border-radius: 0; font-size: 1.2rem; flex-shrink: 0; }
    .material-icon.link { background: #28a745; }
    .material-info { flex: 1; min-width: 200px; }
    .material-name { font-weight: 600; color: #333; margin-bottom: 0.25rem; }
    .material-desc { font-size: 0.9rem; color: #666; }
    .material-meta { font-size: 0.8rem; color: #888; margin-top: 0.25rem; }
    .material-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .material-actions form { display: inline; }
    .type-selector { display: flex; gap: 1rem; margin-bottom: 1rem; }
    .type-selector label { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; padding: 0.75rem 1rem; border: 2px solid rgba(0,0,0,0.06); border-radius: 0; }
    .type-selector input:checked + span { color: #667eea; }
    .type-selector label:has(input:checked) { border-color: #667eea; background: #f0f3ff; }
    .file-fields, .link-fields { display: none; }
    .file-fields.active, .link-fields.active { display: block; }
    .edit-form { display: none; background: #fff; padding: 1rem; border: 1px solid rgba(0,0,0,0.06); border-radius: 0; margin-top: 0.5rem; width: 100%; }
    .edit-form.active { display: block; }
    .empty { color: #888; font-style: italic; padding: 1rem; text-align: center; }
    .alert { padding: 1rem; border-radius: 5px; margin-bottom: 1rem; }
    .alert-info { background: #e7f3ff; color: #0056b3; }
    .quiz-list { list-style: none; }
    .quiz-item { padding: 1rem; background: #fff; border-radius: 0; margin-bottom: 0.75rem; border: 1px solid rgba(0,0,0,0.06); }
    .quiz-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
    .quiz-icon { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: #ffc107; color: white; border-radius: 0; font-size: 1.2rem; flex-shrink: 0; }
    .quiz-info { flex: 1; min-width: 200px; }
    .quiz-name { font-weight: 600; color: #333; }
    .quiz-desc { font-size: 0.9rem; color: #666; }
    .quiz-meta { font-size: 0.8rem; color: #888; margin-top: 0.25rem; }
    .quiz-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .question-item { background: #fff; padding: 1rem; border: 1px solid rgba(0,0,0,0.06); border-radius: 0; margin-bottom: 0.5rem; }
    .question-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; }
    .answer-item { padding: 0.25rem 0.5rem; margin: 0.25rem 0; font-size: 0.9rem; display: flex; align-items: center; gap: 0.5rem; }
    .answer-item.correct { color: #28a745; font-weight: 500; }
    .btn-warning { background: #ffc107; color: #333; }
    .btn-warning:hover { background: #e0a800; }
    .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; overflow-y: auto; }
    .modal.active { display: flex; justify-content: center; align-items: flex-start; padding: 2rem; }
    .modal-content { background: white; border-radius: 0; padding: 2rem; max-width: 800px; width: 100%; margin: 2rem 0; border-top: 6px solid var(--brand-primary); }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .modal-header h2 { font-size: 1.5rem; color: #333; }
    .close-btn { background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #888; }
    .close-btn:hover { color: #333; }
    .question-form { margin-bottom: 1rem; padding: 1rem; background: #f8f9fa; border-radius: 5px; }
    .answers-container { margin-left: 1rem; }
    .answer-row { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.5rem; }
    .answer-row input[type="text"] { flex: 1; }
    .results-list { max-height: 400px; overflow-y: auto; }
    .result-row { display: flex; justify-content: space-between; padding: 0.75rem; background: #f8f9fa; border-radius: 5px; margin-bottom: 0.5rem; }
  </style>
</head>
<body>
  <%- include('partials/header') %>
  <main class="main">
    <div class="container">
    <a href="/dashboard" class="back-link">← Zpět na dashboard</a>
    
    <h1><%= course.name %></h1>
    <p class="subtitle">Správa kurzu a materiálů</p>
    
    <div class="card">
      <h2>Přidat nový materiál</h2>
      
      <form method="POST" action="/dashboard/courses/<%= course.uuid %>/materials" enctype="multipart/form-data" id="materialForm">
        <div class="form-row">
          <div class="form-group">
            <label for="name">Název materiálu *</label>
            <input type="text" id="name" name="name" required>
          </div>
          <div class="form-group">
            <label for="description">Krátký popis</label>
            <input type="text" id="description" name="description">
          </div>
        </div>
        
        <div class="form-group">
          <label>Typ materiálu *</label>
          <div class="type-selector">
            <label>
              <input type="radio" name="type" value="file" checked onchange="toggleType('file')">
              <span>📄 Soubor</span>
            </label>
            <label>
              <input type="radio" name="type" value="url" onchange="toggleType('url')">
              <span>🔗 Odkaz</span>
            </label>
          </div>
        </div>
        
        <div id="fileFields" class="file-fields active">
          <div class="form-group">
            <label for="file">Vybrat soubor *</label>
            <input type="file" id="file" name="file" accept=".pdf,.docx,.txt,.png,.jpg,.jpeg,.gif,.mp4,.mp3">
            <small style="color: #888; display: block; margin-top: 0.5rem;">
              Povolené formáty: PDF, DOCX, TXT, PNG, JPG, GIF, MP4, MP3. Max. velikost: 30 MB.
            </small>
          </div>
        </div>
        
        <div id="linkFields" class="link-fields">
          <div class="form-group">
            <label for="url">URL adresa *</label>
            <input type="url" id="url" name="url" placeholder="https://...">
          </div>
        </div>
        
        <button type="submit" class="btn">Přidat materiál</button>
      </form>
    </div>
    
    <div class="card">
      <h2>Seznam materiálů (<%= materials.length %>)</h2>
      
      <% if (materials.length > 0) { %>
        <ul class="materials-list">
          <% materials.forEach(material => { %>
            <li class="material-item">
              <div class="material-icon <%= material.type === 'url' ? 'link' : '' %>">
                <% if (material.type === 'file') { %>📄<% } else { %>🔗<% } %>
              </div>
              <div class="material-info">
                <div class="material-name"><%= material.name %></div>
                <% if (material.description) { %>
                  <div class="material-desc"><%= material.description %></div>
                <% } %>
                <div class="material-meta">
                  <% if (material.type === 'file') { %>
                    <%= material.file_name %> (<%= Math.round(material.file_size / 1024) %> KB)
                  <% } else { %>
                    <a href="<%= material.url %>" target="_blank"><%= material.url %></a>
                  <% } %>
                </div>
              </div>
              <div class="material-actions">
                <% if (material.type === 'file') { %>
                  <a href="/uploads/<%= require('path').basename(material.file_path) %>" class="btn btn-secondary btn-sm" download>Stáhnout</a>
                <% } else { %>
                  <a href="<%= material.url %>" class="btn btn-secondary btn-sm" target="_blank">Otevřít</a>
                <% } %>
                <button type="button" class="btn btn-sm" onclick="toggleEditMaterial('<%= material.uuid %>')">Upravit</button>
                <form method="POST" action="/dashboard/courses/<%= course.uuid %>/materials/<%= material.uuid %>/delete" onsubmit="return confirm('Opravdu smazat tento materiál?');">
                  <button type="submit" class="btn btn-danger btn-sm">Smazat</button>
                </form>
              </div>
              
              <div id="edit-<%= material.uuid %>" class="edit-form">
                <form method="POST" action="/dashboard/courses/<%= course.uuid %>/materials/<%= material.uuid %>/edit">
                  <div class="form-row">
                    <div class="form-group">
                      <label>Název</label>
                      <input type="text" name="name" value="<%= material.name %>" required>
                    </div>
                    <div class="form-group">
                      <label>Popis</label>
                      <input type="text" name="description" value="<%= material.description || '' %>">
                    </div>
                  </div>
                  <% if (material.type === 'url') { %>
                    <div class="form-group">
                      <label>URL</label>
                      <input type="url" name="url" value="<%= material.url %>">
                    </div>
                  <% } %>
                  <button type="submit" class="btn btn-sm">Uložit</button>
                  <button type="button" class="btn btn-secondary btn-sm" onclick="toggleEditMaterial('<%= material.uuid %>')">Zrušit</button>
                </form>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="empty">Tento kurz zatím nemá žádné materiály.</p>
      <% } %>
    </div>
    
    <!-- Quizzes Section -->
    <div class="card">
      <h2>Správa kvízů</h2>
      <button class="btn btn-warning" onclick="openQuizModal()">+ Přidat nový kvíz</button>
      
      <div style="margin-top: 1rem;">
        <div id="quizzesList" class="quiz-list"></div>
      </div>
    </div>
    </div>
  </main>

  <!-- Quiz Modal -->
  <div id="quizModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="quizModalTitle">Nový kvíz</h2>
        <button class="close-btn" onclick="closeQuizModal()">&times;</button>
      </div>
      <form id="quizForm" onsubmit="saveQuiz(event)">
        <input type="hidden" id="editQuizUuid" value="">
        <div class="form-group" style="margin-bottom: 1rem;">
          <label for="quizTitle">Název kvízu *</label>
          <input type="text" id="quizTitle" required>
        </div>
        
        <h3 style="margin-bottom: 1rem;">Otázky</h3>
        <div id="questionsContainer"></div>
        <button type="button" class="btn btn-secondary" onclick="addQuestion()">+ Přidat otázku</button>
        
        <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
          <button type="submit" class="btn">Uložit kvíz</button>
          <button type="button" class="btn btn-secondary" onclick="closeQuizModal()">Zrušit</button>
        </div>
      </form>
    </div>
  </div>
  
  <!-- Results Modal -->
  <div id="resultsModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Výsledky kvízu</h2>
        <button class="close-btn" onclick="closeResultsModal()">&times;</button>
      </div>
      <div id="resultsContent" class="results-list"></div>
    </div>
  </div>
  
  <script>
    const courseUuid = '<%= course.uuid %>';
    let questionCounter = 0;
    
    // Load quizzes on page load
    document.addEventListener('DOMContentLoaded', loadQuizzes);
    
    async function loadQuizzes() {
      try {
        const response = await fetch(`/api/courses/${courseUuid}/quizzes`);
        const quizzes = await response.json();
        renderQuizzesList(quizzes);
      } catch (error) {
        console.error('Error loading quizzes:', error);
      }
    }
    
    function renderQuizzesList(quizzes) {
      const container = document.getElementById('quizzesList');
      
      if (quizzes.length === 0) {
        container.innerHTML = '<p class="empty">Tento kurz zatím nemá žádné kvízy.</p>';
        return;
      }
      
      container.innerHTML = quizzes.map(quiz => `
        <div class="quiz-item">
          <div class="quiz-header">
            <div class="quiz-icon">📝</div>
            <div class="quiz-info">
              <div class="quiz-name">${quiz.title}</div>
              <div class="quiz-meta">${quiz.questions.length} otázek • Vyplněno ${quiz.completionCount}×</div>
            </div>
            <div class="quiz-actions">
              <button class="btn btn-sm" onclick="editQuiz('${quiz.uuid}')">Upravit</button>
              <button class="btn btn-secondary btn-sm" onclick="viewResults('${quiz.uuid}')">Výsledky</button>
              <button class="btn btn-danger btn-sm" onclick="deleteQuiz('${quiz.uuid}')">Smazat</button>
            </div>
          </div>
          ${quiz.questions.length > 0 ? `
            <div style="margin-top: 0.5rem; margin-left: 3.5rem;">
              ${quiz.questions.slice(0, 3).map((q, i) => `
                <div class="question-item">
                  <div class="question-header">
                    <strong>${i + 1}. ${q.question}</strong>
                    <span style="font-size: 0.8rem; color: #888;">${q.type === 'singleChoice' ? 'Jedna odpověď' : 'Více odpovědí'}</span>
                  </div>
                  <div class="answers-container">
                    ${q.options.map((opt, idx) => `
                      <div class="answer-item ${q.type === 'singleChoice' ? (idx === q.correctIndex ? 'correct' : '') : (q.correctIndices?.includes(idx) ? 'correct' : '')}">
                        ${q.type === 'singleChoice' ? (idx === q.correctIndex ? '✓' : '○') : (q.correctIndices?.includes(idx) ? '✓' : '○')} ${opt}
                      </div>
                    `).join('')}
                  </div>
                </div>
              `).join('')}
              ${quiz.questions.length > 3 ? `<p style="color: #888; font-style: italic;">... a další ${quiz.questions.length - 3} otázek</p>` : ''}
            </div>
          ` : ''}
        </div>
      `).join('');
    }
    
    function openQuizModal() {
      document.getElementById('editQuizUuid').value = '';
      document.getElementById('quizModalTitle').textContent = 'Nový kvíz';
      document.getElementById('quizTitle').value = '';
      document.getElementById('questionsContainer').innerHTML = '';
      questionCounter = 0;
      addQuestion();
      document.getElementById('quizModal').classList.add('active');
    }
    
    function closeQuizModal() {
      document.getElementById('quizModal').classList.remove('active');
    }
    
    async function editQuiz(quizUuid) {
      try {
        const response = await fetch(`/api/courses/${courseUuid}/quizzes/${quizUuid}`);
        const quiz = await response.json();
        
        document.getElementById('editQuizUuid').value = quiz.uuid;
        document.getElementById('quizModalTitle').textContent = 'Upravit kvíz';
        document.getElementById('quizTitle').value = quiz.title;
        document.getElementById('questionsContainer').innerHTML = '';
        questionCounter = 0;
        
        quiz.questions.forEach(q => {
          addQuestion(q);
        });
        
        if (quiz.questions.length === 0) {
          addQuestion();
        }
        
        document.getElementById('quizModal').classList.add('active');
      } catch (error) {
        console.error('Error loading quiz:', error);
        alert('Nepodařilo se načíst kvíz');
      }
    }
    
    function addQuestion(existingQuestion = null) {
      const container = document.getElementById('questionsContainer');
      const qIndex = questionCounter++;
      
      const div = document.createElement('div');
      div.className = 'question-form';
      div.id = `question-${qIndex}`;
      div.innerHTML = `
        <div class="form-row">
          <div class="form-group" style="flex: 2;">
            <label>Text otázky *</label>
            <input type="text" class="question-text" value="${existingQuestion ? existingQuestion.question : ''}" required>
          </div>
          <div class="form-group" style="flex: 1;">
            <label>Typ</label>
            <select class="question-type">
              <option value="singleChoice" ${existingQuestion?.type === 'singleChoice' ? 'selected' : ''}>Jedna odpověď</option>
              <option value="multipleChoice" ${existingQuestion?.type === 'multipleChoice' ? 'selected' : ''}>Více odpovědí</option>
            </select>
          </div>
          <button type="button" class="btn btn-danger btn-sm" onclick="removeQuestion(${qIndex})" style="align-self: flex-end;">×</button>
        </div>
        <div class="answers-container" id="answers-${qIndex}">
          <label>Odpovědi (označte správné):</label>
        </div>
        <button type="button" class="btn btn-secondary btn-sm" onclick="addAnswer(${qIndex})" style="margin-top: 0.5rem;">+ Přidat odpověď</button>
      `;
      container.appendChild(div);
      
      if (existingQuestion && existingQuestion.options) {
        existingQuestion.options.forEach((opt, idx) => {
          const isCorrect = existingQuestion.type === 'singleChoice' 
            ? idx === existingQuestion.correctIndex 
            : existingQuestion.correctIndices?.includes(idx);
          addAnswer(qIndex, { text: opt, isCorrect });
        });
      } else {
        addAnswer(qIndex);
        addAnswer(qIndex);
      }
    }
    
    function removeQuestion(qIndex) {
      const el = document.getElementById(`question-${qIndex}`);
      if (el) el.remove();
    }
    
    let answerCounters = {};
    function addAnswer(qIndex, existingAnswer = null) {
      if (!answerCounters[qIndex]) answerCounters[qIndex] = 0;
      const aIndex = answerCounters[qIndex]++;
      
      const container = document.getElementById(`answers-${qIndex}`);
      const div = document.createElement('div');
      div.className = 'answer-row';
      div.id = `answer-${qIndex}-${aIndex}`;
      div.innerHTML = `
        <input type="checkbox" class="answer-correct" ${existingAnswer?.isCorrect ? 'checked' : ''}>
        <input type="text" class="answer-text" value="${existingAnswer ? existingAnswer.text : ''}" placeholder="Text odpovědi" required>
        <button type="button" class="btn btn-danger btn-sm" onclick="removeAnswer(${qIndex}, ${aIndex})">×</button>
      `;
      container.appendChild(div);
    }
    
    function removeAnswer(qIndex, aIndex) {
      const el = document.getElementById(`answer-${qIndex}-${aIndex}`);
      if (el) el.remove();
    }
    
    async function saveQuiz(e) {
      e.preventDefault();
      
      const quizUuid = document.getElementById('editQuizUuid').value;
      const title = document.getElementById('quizTitle').value;
      
      const questions = [];
      document.querySelectorAll('.question-form').forEach(qForm => {
        const questionText = qForm.querySelector('.question-text').value;
        const type = qForm.querySelector('.question-type').value;
        const options = [];
        const correctIndices = [];
        let correctIndex = null;
        
        let idx = 0;
        qForm.querySelectorAll('.answer-row').forEach(aRow => {
          const aText = aRow.querySelector('.answer-text').value;
          const isCorrect = aRow.querySelector('.answer-correct').checked;
          if (aText) {
            options.push(aText);
            if (isCorrect) {
              if (type === 'singleChoice' && correctIndex === null) {
                correctIndex = idx;
              } else {
                correctIndices.push(idx);
              }
            }
            idx++;
          }
        });
        
        if (questionText && options.length > 0) {
          const q = { question: questionText, type, options };
          if (type === 'singleChoice') {
            q.correctIndex = correctIndex !== null ? correctIndex : 0;
          } else {
            q.correctIndices = correctIndices;
          }
          questions.push(q);
        }
      });
      
      const data = { title, questions };
      
      try {
        const url = quizUuid 
          ? `/api/courses/${courseUuid}/quizzes/${quizUuid}`
          : `/api/courses/${courseUuid}/quizzes`;
        
        const response = await fetch(url, {
          method: quizUuid ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        
        if (response.ok) {
          closeQuizModal();
          loadQuizzes();
        } else {
          const error = await response.json();
          alert(error.error || 'Nepodařilo se uložit kvíz');
        }
      } catch (error) {
        console.error('Error saving quiz:', error);
        alert('Nepodařilo se uložit kvíz');
      }
    }
    
    async function deleteQuiz(quizUuid) {
      if (!confirm('Opravdu smazat tento kvíz? Budou smazány i všechny výsledky.')) return;
      
      try {
        const response = await fetch(`/api/courses/${courseUuid}/quizzes/${quizUuid}`, {
          method: 'DELETE'
        });
        
        if (response.ok) {
          loadQuizzes();
        } else {
          alert('Nepodařilo se smazat kvíz');
        }
      } catch (error) {
        console.error('Error deleting quiz:', error);
        alert('Nepodařilo se smazat kvíz');
      }
    }
    
    async function viewResults(quizUuid) {
      try {
        const response = await fetch(`/api/courses/${courseUuid}/quizzes/${quizUuid}/results`);
        
        if (response.status === 401) {
          alert('Pro zobrazení výsledků musíte být přihlášeni');
          return;
        }
        
        const results = await response.json();
        
        const container = document.getElementById('resultsContent');
        
        if (results.length === 0) {
          container.innerHTML = '<p class="empty">Tento kvíz zatím nikdo nevyplnil.</p>';
        } else {
          container.innerHTML = results.map((r, i) => `
            <div class="result-row">
              <span>#${i + 1}</span>
              <span><strong>${r.score} / ${r.maxScore}</strong> (${r.percentage}%)</span>
              <span style="color: #888; font-size: 0.9rem;">${new Date(r.createdAt).toLocaleString('cs')}</span>
            </div>
          `).join('');
        }
        
        document.getElementById('resultsModal').classList.add('active');
      } catch (error) {
        console.error('Error loading results:', error);
        alert('Nepodařilo se načíst výsledky');
      }
    }
    
    function closeResultsModal() {
      document.getElementById('resultsModal').classList.remove('active');
    }
    
    // Close modals when clicking outside
    document.getElementById('quizModal').addEventListener('click', function(e) {
      if (e.target === this) closeQuizModal();
    });
    document.getElementById('resultsModal').addEventListener('click', function(e) {
      if (e.target === this) closeResultsModal();
    });
    
    function toggleType(type) {
      document.getElementById('fileFields').classList.toggle('active', type === 'file');
      document.getElementById('linkFields').classList.toggle('active', type === 'url');
      document.getElementById('file').required = (type === 'file');
      document.getElementById('url').required = (type === 'url');
    }
    
    function toggleEditMaterial(uuid) {
      document.getElementById('edit-' + uuid).classList.toggle('active');
    }
    
    // Burger menu
    const burger = document.getElementById('burgerBtn');
    const navLinks = document.getElementById('navLinks');
    const overlay = document.getElementById('navOverlay');
    function toggleMenu() {
      burger.classList.toggle('active');
      navLinks.classList.toggle('active');
      overlay.classList.toggle('active');
    }
    burger.addEventListener('click', toggleMenu);
    overlay.addEventListener('click', toggleMenu);
  </script>

  <%- include('partials/footer') %>
</body>
</html>
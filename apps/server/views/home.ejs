<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Think different Academy</title>
  <link rel="stylesheet" href="/css/common.css">
  <style>
    /* swapped: body uses brand-primary, navbar uses the previous home color */
    body { background: var(--brand-primary); }
    .navbar { background: #0257A5; }
    .hero { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 80vh; text-align: center; color: white; padding: 2rem; }
    .home-logo { height: 280px; width: auto; margin-bottom: 2rem; }
    .hero .lead { font-size: 1.25rem; margin-bottom: 1.75rem; opacity: 0.95; }
    .hero h1 { font-size: 3.5rem; margin-bottom: 1rem; text-shadow: 2px 2px 4px rgba(0,0,0,0.2); }
    .hero p { font-size: 1.5rem; margin-bottom: 2.5rem; opacity: 0.9; }
    /* CTA uses .btn-cta from common.css */
    @media (max-width: 768px) {
      .hero h1 { font-size: 2.2rem; }
      .hero p { font-size: 1.1rem; }
      /* reduce main logo 20% on smaller devices */
      .home-logo { height: 224px; }
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>
  <div class="hero">
    <!-- Main logo (centered) -->
    <img class="home-logo" src="/img/Think-different-Academy_LOGO_oficialni-bile2.svg" alt="Think different Academy logo">

    <!-- Short lead text -->
    <p class="lead">Vítejte v Think different Academy — správa kurzů a interaktivní výuka pro studenty i lektory.</p>

    <!-- CTA button (elevated brand style) -->
    <a class="btn-cta" href="/courses" aria-label="Prohlédnout kurzy">
      <span>Prohlédnout kurzy</span>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
        <path d="M8 5l8 7-8 7" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Think different Academy</title>
  <link rel="stylesheet" href="/css/common.css">
  <style>
    .container { max-width: 1200px; margin: 0 auto; padding: 2rem; }
    h1 { color: var(--brand-blue-dark); margin-bottom: 0.5rem; }
    .subtitle { color: #666; margin-bottom: 2rem; }
    /* Flat cards consistent with site aesthetic */
    .card { background: #ffffff; border-radius: 0; padding: 1.5rem; box-shadow: none; margin-bottom: 2rem; border-top: 6px solid var(--brand-primary); }
    .card h2 { color: var(--brand-blue-dark); margin-bottom: 1rem; font-size: 1.3rem; }
    .form-row { display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; }
    .form-group { flex: 1; min-width: 200px; }
    .form-group label { display: block; margin-bottom: 0.5rem; color: #555; font-weight: 500; }
    .form-group input, .form-group textarea { width: 100%; padding: 0.75rem; border: 1px solid rgba(0,0,0,0.06); border-radius: 0; font-size: 1rem; background: #fff; }
    .form-group textarea { resize: vertical; min-height: 80px; }
    /* Buttons: rectangular with small radius to match site */
    .btn { padding: 0.6rem 1rem; background: var(--brand-primary); color: #fff; border: 2px solid rgba(0,0,0,0.06); border-radius: 6px; cursor: pointer; font-size: 0.95rem; font-weight:700; text-decoration: none; display: inline-block; }
    .btn:hover { filter: brightness(1.04); }
    .btn-sm { padding: 0.45rem 0.9rem; font-size: 0.875rem; }
    .btn-danger { background: #dc3545; border-color: rgba(0,0,0,0.06); color: #fff; border-radius: 6px; }
    .btn-danger:hover { filter: brightness(0.95); }
    .btn-secondary { background: #6c757d; border-color: rgba(0,0,0,0.06); color: #fff; border-radius: 6px; }
    .btn-secondary:hover { filter: brightness(0.95); }
    .btn-success { background: #28a745; border-color: rgba(0,0,0,0.06); color: #fff; border-radius: 6px; }
    .btn-success:hover { filter: brightness(0.98); }
    table { width: 100%; border-collapse: collapse; }
    th, td { padding: 1rem; text-align: left; border-bottom: 1px solid #eee; }
    th { background: #f8f9fa; font-weight: 600; color: #333; }
    .actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .actions form { display: inline; }
    .edit-form { display: none; background: #ffffff; padding: 1rem; border-radius: 0; margin-top: 0.5rem; border-top: 4px solid rgba(0,0,0,0.03); }
    .edit-form.active { display: block; }
    @media (max-width: 768px) {
      .container { padding: 1rem; }
      table, thead, tbody, th, td, tr { display: block; }
      thead { display: none; }
      tr { margin-bottom: 1rem; background: #ffffff; border-radius: 0; padding: 1rem; border-top: 4px solid rgba(0,0,0,0.03); }
      td { padding: 0.5rem 0; border: none; }
      td:before { content: attr(data-label); font-weight: 600; display: block; margin-bottom: 0.25rem; }
    }
    .navbar { background: var(--brand-primary); }
  </style>
</head>
<body>
  <%- include('partials/header') %>
  <main class="main">
    <div class="container">
    <h1>Dashboard</h1>
    <p class="subtitle">Správa kurzů</p>
    
    <div class="card">
      <h2>Přidat nový kurz</h2>
      <form method="POST" action="/dashboard/courses">
        <div class="form-row">
          <div class="form-group">
            <label for="name">Název kurzu *</label>
            <input type="text" id="name" name="name" required>
          </div>
          <div class="form-group">
            <label for="shortDescription">Krátký popis</label>
            <input type="text" id="shortDescription" name="shortDescription">
          </div>
        </div>
        <div class="form-group">
          <label for="description">Popis</label>
          <textarea id="description" name="description"></textarea>
        </div>
        <button type="submit" class="btn">Přidat kurz</button>
      </form>
    </div>
    
    <div class="card">
      <h2>Seznam kurzů</h2>
      <% if (courses.length > 0) { %>
        <table>
          <thead>
            <tr>
              <th>Název</th>
              <th>Krátký popis</th>
              <th>Akce</th>
            </tr>
          </thead>
          <tbody>
            <% courses.forEach((course, index) => { %>
              <tr>
                <td><%= course.name %></td>
                <td><%= course.short_description || '-' %></td>
                <td class="actions">
                  <a href="/courses/<%= course.uuid %>" class="btn btn-secondary btn-sm">Zobrazit</a>
                  <a href="/dashboard/courses/<%= course.uuid %>" class="btn btn-success btn-sm">Materiály</a>
                  <button type="button" class="btn btn-sm" onclick="toggleEdit('<%= course.uuid %>')">Upravit</button>
                  <form method="POST" action="/dashboard/courses/<%= course.uuid %>/delete" onsubmit="return confirm('Opravdu chcete smazat tento kurz?');">
                    <button type="submit" class="btn btn-danger btn-sm">Smazat</button>
                  </form>
                </td>
              </tr>
              <tr>
                <td colspan="3">
                  <div id="edit-<%= course.uuid %>" class="edit-form">
                    <form method="POST" action="/dashboard/courses/<%= course.uuid %>/edit">
                      <div class="form-row">
                        <div class="form-group">
                          <label>Název kurzu</label>
                          <input type="text" name="name" value="<%= course.name %>" required>
                        </div>
                        <div class="form-group">
                          <label>Krátký popis</label>
                          <input type="text" name="shortDescription" value="<%= course.short_description || '' %>">
                        </div>
                      </div>
                      <div class="form-group">
                        <label>Popis</label>
                        <textarea name="description"><%= course.description || '' %></textarea>
                      </div>
                      <button type="submit" class="btn btn-sm">Uložit změny</button>
                      <button type="button" class="btn btn-secondary btn-sm" onclick="toggleEdit('<%= course.uuid %>')">Zrušit</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p>Zatím nejsou žádné kurzy. Přidejte první kurz výše.</p>
      <% } %>
    </div>
    </div>
  </main>

  <script>
    function toggleEdit(uuid) {
      const form = document.getElementById('edit-' + uuid);
      form.classList.toggle('active');
    }
    // Burger menu
    const burger = document.getElementById('burgerBtn');
    const navLinks = document.getElementById('navLinks');
    const overlay = document.getElementById('navOverlay');
    function toggleMenu() {
      burger.classList.toggle('active');
      navLinks.classList.toggle('active');
      overlay.classList.toggle('active');
    }
    burger.addEventListener('click', toggleMenu);
    overlay.addEventListener('click', toggleMenu);
  </script>

  <%- include('partials/footer') %>
</body>
</html>
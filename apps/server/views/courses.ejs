<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kurzy - Think different Academy</title>
  <link rel="stylesheet" href="/css/common.css">
  <style>
    .container { max-width: 1200px; margin: 0 auto; padding: 2rem; }
    h1 { color: var(--brand-blue-dark); margin-bottom: 1.5rem; }
    .search-form { margin-bottom: 2rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
    /* Search field: flat, modest radius to match page aesthetic */
    .search-form input { padding: 0.85rem 1rem; width: 360px; max-width: 100%; border: 1px solid rgba(0,0,0,0.06); border-radius: 6px; font-size: 1rem; background: #fff; box-shadow: none; }
    .search-form input::placeholder { color: #9aa3ab; font-size: 1rem; }
    .search-form button { padding: 0.6rem 1rem; background: var(--brand-primary); color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 0.95rem; align-self: center; border: 2px solid rgba(255,255,255,0.06); }
    .search-form button:hover { filter: brightness(1.04); }
    .courses-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; }
    /* Flat cards to match homepage aesthetic */
    .course-card { background: #ffffff; border-radius: 0; padding: 1.5rem; box-shadow: none; transition: transform 0.12s ease; border-top: 6px solid var(--brand-primary); }
    .course-card:hover { transform: translateY(-4px); }
    .course-card h2 { color: #333; margin-bottom: 0.75rem; font-size: 1.3rem; }
    .course-card p { color: #666; margin-bottom: 1rem; line-height: 1.5; }
    /* Flat rectangular CTA for cards (not pill) */
    .course-card a { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.9rem; text-decoration: none; font-weight: 700; font-size: 0.95rem; border-radius: 6px; background: var(--brand-primary); color: #fff; border: 2px solid rgba(255,255,255,0.14); }
    .course-card a svg { width: 14px; height: 14px; }
    .course-card a:hover { filter: brightness(1.04); }
    .no-courses { text-align: center; padding: 3rem; color: #666; }
    @media (max-width: 768px) {
      .container { padding: 1rem; }
      .search-form input { width: 100%; }
    }
    .navbar { background: var(--brand-primary); }
  </style>
</head>
  <body>
  <%- include('partials/header') %>
  <main class="main">
    <div class="container">
    <h1>Dostupné kurzy</h1>
    
    <form class="search-form" method="GET" action="/courses">
      <input type="text" name="search" placeholder="Hledat kurz..." value="<%= search %>">
      <button type="submit">Hledat</button>
    </form>
    
    <% if (courses.length > 0) { %>
      <div class="courses-grid">
        <% courses.forEach(course => { %>
          <div class="course-card">
            <h2><%= course.name %></h2>
            <p><%= course.short_description || course.description || 'Bez popisu' %></p>
            <a href="/courses/<%= course.uuid %>">Zobrazit detail</a>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="no-courses">
        <p>Žádné kurzy nenalezeny.</p>
      </div>
    <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
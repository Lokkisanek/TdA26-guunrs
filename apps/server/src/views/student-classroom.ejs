<%- include('partials/header', { title }) %>
<style>
  .lesson-header h1 { color: var(--brand-blue-dark); font-size: 1.8rem; margin-bottom: 0.25rem; }
  .lesson-header .meta { color: #888; font-size: 0.9rem; margin-bottom: 1rem; }
  .connection-bar { padding: 0.5rem 1rem; text-align: center; font-weight: 700; font-size: 0.85rem; border-radius: 6px; margin-bottom: 1rem; }
  .connection-bar.connected { background: #d4edda; color: #155724; }
  .connection-bar.disconnected { background: #f8d7da; color: #721c24; animation: blink-bar 1.5s infinite; }
  .connection-bar.reconnecting { background: #fff3cd; color: #856404; }
  @keyframes blink-bar { 0%,100% { opacity:1; } 50% { opacity:0.6; } }
  .state-banner { padding: 0.75rem 1rem; text-align: center; font-weight: 700; font-size: 1rem; border-radius: 6px; margin-bottom: 1.5rem; }
  .state-banner.LIVE { background: #28a745; color: #fff; }
  .state-banner.PAUSED { background: #fff3cd; color: #856404; }
  .state-banner.ARCHIVED { background: #f8d7da; color: #721c24; }
  .state-banner.DRAFT, .state-banner.SCHEDULED { background: #e9ecef; color: #555; }
  .classroom-layout { display: grid; grid-template-columns: 240px 1fr; gap: 1.5rem; align-items: start; }
  .sidebar { background: #fff; border-top: 6px solid var(--brand-primary); padding: 1rem; }
  .sidebar h3 { font-size: 1rem; color: var(--brand-blue-dark); margin-bottom: 0.75rem; }
  .nav-list { list-style: none; padding: 0; }
  .nav-item { padding: 0.55rem 0.75rem; cursor: pointer; border-radius: 4px; margin-bottom: 0.25rem; font-weight: 600; font-size: 0.9rem; transition: background 0.15s; display: flex; align-items: center; gap: 0.4rem; }
  .nav-item:hover { background: #f0f5ff; }
  .nav-item.active { background: #e3f0ff; border-left: 4px solid var(--brand-primary); }
  .nav-item .type-badge { font-size: 0.7rem; color: #888; background: #f0f0f0; padding: 0.1rem 0.35rem; border-radius: 3px; }
  .sidebar.sync-locked { opacity: 0.6; pointer-events: none; }
  .sidebar.sync-locked::after { content: '<%= t("nav_locked") %>'; display: block; text-align: center; color: #dc3545; font-size: 0.8rem; margin-top: 0.75rem; font-weight: 700; }
  .content-panel { background: #fff; border-top: 6px solid var(--brand-primary); padding: 1.5rem; min-height: 500px; }
  .content-panel h2 { color: var(--brand-blue-dark); margin-bottom: 0.75rem; }
  .content-panel .page-type-label { font-size: 0.8rem; color: #888; margin-bottom: 1rem; display: block; }
  .content-empty { color: #aaa; text-align: center; padding: 4rem 1rem; }
  .video-placeholder { display: flex; align-items: center; justify-content: center; height: 300px; background: #111; color: #aaa; font-size: 1.2rem; border-radius: 4px; margin-bottom: 1rem; }
  .text-content { line-height: 1.8; font-size: 1.05rem; color: #333; }
  .text-content p { margin-bottom: 1rem; }
  .quiz-question { background: #f8f9fa; padding: 1rem; border-radius: 4px; margin-bottom: 1rem; }
  .quiz-question .q-text { font-weight: 700; margin-bottom: 0.75rem; color: #333; }
  .quiz-question .q-option { display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.5rem; cursor: pointer; border-radius: 4px; margin-bottom: 0.3rem; }
  .quiz-question .q-option:hover { background: #e3f0ff; }
  .quiz-question .q-option input { margin: 0; }
  .quiz-submit { width: 100%; padding: 0.85rem; background: var(--brand-primary); color: #fff; border: 2px solid rgba(0,0,0,0.06); border-radius: 6px; font-size: 1rem; font-weight: 700; cursor: pointer; margin-top: 1rem; font-family: inherit; }
  .quiz-submit:hover { filter: brightness(1.1); }
  .quiz-submit:disabled { opacity: 0.5; cursor: not-allowed; }
  .quiz-result { text-align: center; padding: 2rem; }
  .quiz-result .score { font-size: 3rem; font-weight: 700; color: var(--brand-primary); }
  .quiz-result .score.high { color: #28a745; }
  .quiz-result .score.medium { color: #ffc107; }
  .quiz-result .score.low { color: #dc3545; }
  .quiz-result .label { font-size: 1.1rem; color: #666; }
  .quiz-result-detail { margin-top: 1.5rem; text-align: left; }
  .quiz-result-item { padding: 0.75rem 1rem; margin-bottom: 0.5rem; border-radius: 6px; border-left: 4px solid #ccc; background: #f8f9fa; }
  .quiz-result-item.correct { border-left-color: #28a745; background: #d4edda; }
  .quiz-result-item.incorrect { border-left-color: #dc3545; background: #f8d7da; }
  .quiz-result-item .result-icon { font-size: 1.2rem; margin-right: 0.5rem; }
  .quiz-result-item .result-text { font-weight: 600; }
  .quiz-result-item .result-answer { font-size: 0.85rem; color: #555; margin-top: 0.25rem; }
  .stylized-divider { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; padding: 4rem 2rem; text-align: center; border-radius: 4px; font-size: 1.5rem; font-weight: 700; }
  .mode-toggle { display: inline-flex; gap: 0; border: 2px solid var(--brand-primary); border-radius: 6px; overflow: hidden; margin-bottom: 1rem; }
  .mode-toggle button { padding: 0.4rem 0.85rem; border: none; background: #fff; font-weight: 700; font-size: 0.85rem; cursor: pointer; color: var(--brand-primary); font-family: inherit; }
  .mode-toggle button.active { background: var(--brand-primary); color: #fff; }
  @media (max-width: 768px) { .classroom-layout { grid-template-columns: 1fr; } }
</style>

<div class="container">
<a href="/courses/<%= lesson.courseId %>" class="back-link">&larr; <%= t('back_to_course') %></a>

<div class="lesson-header">
  <h1><%= lesson.title %></h1>
  <p class="meta">Kurz: <%= lesson.course.title %></p>
</div>

<div class="connection-bar connected" id="connectionBar"><%= t('connected') %></div>
<div class="state-banner <%= session.currentState %>" id="stateBanner">
  <%= session.currentState === 'LIVE' ? t('live_broadcast') : session.currentState === 'PAUSED' ? t('paused') : session.currentState === 'ARCHIVED' ? t('archived') : t('waiting_start') %>
</div>

<div class="classroom-layout">
  <div class="sidebar" id="sidebar">
    <h3><%= t('lesson_content') %></h3>
    <div class="mode-toggle" id="modeToggle" style="display:none;">
      <button id="btnSync" class="active">Sync</button>
      <button id="btnAsync">Async</button>
    </div>
    <ul class="nav-list" id="navList"></ul>
  </div>

  <div class="content-panel" id="contentPanel">
    <div class="content-empty" id="contentEmpty"><p><%= t('waiting_teacher') %></p></div>
    <div id="contentDisplay" style="display:none;"></div>
  </div>
</div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
(function() {
  var SESSION_ID = '<%= session.id %>';
  var STUDENT_ID = 'student_' + Math.random().toString(36).substr(2, 9);
  var pages = <%- JSON.stringify(publishedPages) %>;
  var currentState = '<%= session.currentState %>';
  var activePageId = '<%= session.activePageId || "" %>';
  var mode = 'sync';
  var currentViewPageId = null;
  var quizSubmitted = {};

  var i18n = {
    connected: '<%= t("connected") %>',
    disconnected: '<%= t("disconnected") %>',
    reconnecting: '<%= t("reconnecting") %>',
    live: '<%= t("live_broadcast") %>',
    paused: '<%= t("paused") %>',
    archived: '<%= t("archived") %>',
    waiting: '<%= t("waiting_start") %>',
    scheduled: '<%= t("scheduled") %>',
    video_na: '<%= t("video_unavailable") %>',
    empty: '<%= t("empty_content") %>',
    quiz_error: '<%= t("quiz_load_error") %>',
    quiz_no_q: '<%= t("quiz_no_questions") %>',
    submit_answers: '<%= t("submit_answers") %>',
    quiz_submitted: '<%= t("quiz_submitted") %>',
    submitting: '<%= t("quiz_submitted_progress") %>',
    your_score: '<%= t("your_score") %>',
    page_hidden: '<%= t("page_hidden") %>',
    your_answer: '<%= t("your_answer") %>',
    correct_answer: '<%= t("correct_answer") %>',
    correct_text: '<%= t("correct") %>'
  };

  var socket = io('/classroom', {
    query: { sessionId: SESSION_ID, role: 'student', studentId: STUDENT_ID },
    reconnection: true, reconnectionAttempts: Infinity,
    reconnectionDelay: 1000, reconnectionDelayMax: 5000,
  });

  socket.on('connect', function() {
    updateConnectionBar('connected', i18n.connected);
    socket.emit('request_state_recovery');
  });
  socket.on('disconnect', function() { updateConnectionBar('disconnected', i18n.disconnected); });
  socket.io.on('reconnect_attempt', function() { updateConnectionBar('reconnecting', i18n.reconnecting); });
  socket.on('error_msg', function(data) { console.warn('[student] Error:', data.message); });

  socket.on('state_recovery', function(data) {
    currentState = data.state; activePageId = data.activePageId || ''; pages = data.pages;
    updateStateBanner(); renderNav();
    if (mode === 'sync' && activePageId) navigateTo(activePageId);
  });

  socket.on('session_state_update', function(data) {
    currentState = data.state; activePageId = data.activePageId || '';
    updateStateBanner();
    if (mode === 'sync' && activePageId) navigateTo(activePageId);
  });

  socket.on('monitor_update', function(data) {
    if (mode === 'sync' && data.pageId) navigateTo(data.pageId);
  });

  socket.on('page_visibility_update', function(data) {
    if (data.isPublished) {
      if (!pages.find(function(p) { return p.id === data.pageId; })) socket.emit('request_state_recovery');
    } else {
      pages = pages.filter(function(p) { return p.id !== data.pageId; });
      renderNav();
      if (currentViewPageId === data.pageId) showEmpty(i18n.page_hidden);
    }
  });

  socket.on('quiz_result', function(data) { showQuizResult(data.score, data.answerResults); });

  function setMode(m) {
    mode = m;
    document.getElementById('btnSync').classList.toggle('active', m === 'sync');
    document.getElementById('btnAsync').classList.toggle('active', m === 'async');
    document.getElementById('sidebar').classList.toggle('sync-locked', m === 'sync');
    if (m === 'sync' && activePageId) navigateTo(activePageId);
  }

  function renderNav() {
    var list = document.getElementById('navList'); list.innerHTML = '';
    pages.forEach(function(page) {
      var li = document.createElement('li');
      li.className = 'nav-item' + (page.id === currentViewPageId ? ' active' : '');
      li.dataset.id = page.id;
      li.innerHTML = '<span>' + page.title + '</span> <span class="type-badge">' + page.type + '</span>';
      li.addEventListener('click', function() { if (mode !== 'sync') navigateTo(page.id); });
      list.appendChild(li);
    });
    document.getElementById('modeToggle').style.display = ['LIVE', 'PAUSED'].indexOf(currentState) !== -1 ? '' : 'none';
  }

  function navigateTo(pageId) {
    var page = pages.find(function(p) { return p.id === pageId; });
    if (!page) return;
    currentViewPageId = pageId;
    renderContent(page); renderNav();
    socket.emit('student_ack_page', { pageId: pageId });
  }

  function renderContent(page) {
    document.getElementById('contentEmpty').style.display = 'none';
    var display = document.getElementById('contentDisplay');
    display.style.display = 'block';
    var html = '<h2>' + page.title + '</h2><span class="page-type-label">' + page.type + '</span>';
    switch (page.type) {
      case 'video':
        if (page.content && (page.content.indexOf('youtube') !== -1 || page.content.indexOf('vimeo') !== -1)) {
          html += '<div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;background:#000;border-radius:4px;margin-bottom:1rem;"><iframe src="' + page.content + '" style="position:absolute;top:0;left:0;width:100%;height:100%;" frameborder="0" allowfullscreen></iframe></div>';
        } else if (page.content) {
          html += '<div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;background:#000;border-radius:4px;margin-bottom:1rem;"><video controls src="' + page.content + '" style="position:absolute;top:0;left:0;width:100%;height:100%;"></video></div>';
        } else { html += '<div class="video-placeholder">' + i18n.video_na + '</div>'; }
        break;
      case 'quiz': html += renderQuizForm(page); break;
      case 'empty_stylized': html += '<div class="stylized-divider">' + (page.content || '') + '</div>'; break;
      default: html += '<div class="text-content">' + (page.content || '<p>' + i18n.empty + '</p>') + '</div>'; break;
    }
    display.innerHTML = html;
    if (page.type === 'quiz') {
      var form = document.getElementById('quizForm');
      if (form) form.addEventListener('submit', function(e) { e.preventDefault(); submitQuiz(page.id); });
    }
  }

  function renderQuizForm(page) {
    if (quizSubmitted[page.id]) return '<div class="quiz-result"><div class="label">' + i18n.quiz_submitted + ' &#10003;</div></div>';
    var quiz;
    try { quiz = JSON.parse(page.content || '{}'); } catch(e) { return '<p>' + i18n.quiz_error + '</p>'; }
    if (!quiz.questions || !quiz.questions.length) return '<p>' + i18n.quiz_no_q + '</p>';
    var html = '<form id="quizForm" class="quiz-container">';
    quiz.questions.forEach(function(q, i) {
      html += '<div class="quiz-question"><div class="q-text">' + (i + 1) + '. ' + (q.text || q.question || '') + '</div>';
      if (q.options && Array.isArray(q.options)) {
        q.options.forEach(function(opt, j) {
          var val = opt.value !== undefined ? opt.value : j;
          var label = opt.label || opt.text || opt;
          html += '<label class="q-option"><input type="radio" name="q_' + (q.id || i) + '" value="' + val + '" required><span>' + label + '</span></label>';
        });
      }
      html += '</div>';
    });
    html += '<button type="submit" class="quiz-submit">' + i18n.submit_answers + '</button></form>';
    return html;
  }

  function submitQuiz(pageId) {
    var form = document.getElementById('quizForm');
    if (!form) return;
    var formData = new FormData(form);
    var answers = {};
    formData.forEach(function(value, key) { answers[key.replace('q_', '')] = value; });
    socket.emit('submit_quiz', { pageId: pageId, answers: answers });
    quizSubmitted[pageId] = true;
    var btn = form.querySelector('.quiz-submit');
    if (btn) { btn.disabled = true; btn.textContent = i18n.submitting; }
  }

  function showQuizResult(score, answerResults) {
    var form = document.getElementById('quizForm');
    if (!form) return;
    var pct = Math.round(score);
    var scoreClass = pct >= 75 ? 'high' : (pct >= 50 ? 'medium' : 'low');
    var resultDiv = document.createElement('div');
    resultDiv.className = 'quiz-result';
    var html = '<div class="score ' + scoreClass + '">' + pct + '%</div><div class="label">' + i18n.your_score + '</div>';

    // Show detailed answers
    if (answerResults && typeof answerResults === 'object') {
      html += '<div class="quiz-result-detail">';
      // Get quiz data for question text
      var currentPage = pages.find(function(p) { return p.id === currentViewPageId; });
      var quizData = null;
      try { quizData = currentPage ? JSON.parse(currentPage.content || '{}') : null; } catch(e) {}
      var questions = quizData && quizData.questions ? quizData.questions : [];

      for (var key in answerResults) {
        var ar = answerResults[key];
        var q = questions.find(function(qu) { return String(qu.id || questions.indexOf(qu)) === String(key); });
        var qText = q ? (q.text || q.question || 'Otázka') : 'Otázka';
        var correctLabel = '';
        var studentLabel = '';

        if (q && q.options) {
          q.options.forEach(function(opt, j) {
            var val = opt.value !== undefined ? String(opt.value) : String(j);
            var label = opt.label || opt.text || opt;
            if (val === String(ar.correctAnswer)) correctLabel = label;
            if (val === String(ar.studentAnswer)) studentLabel = label;
          });
        }
        if (!correctLabel) correctLabel = ar.correctAnswer;
        if (!studentLabel) studentLabel = ar.studentAnswer;

        html += '<div class="quiz-result-item ' + (ar.isCorrect ? 'correct' : 'incorrect') + '">';
        html += '<span class="result-icon">' + (ar.isCorrect ? '✅' : '❌') + '</span>';
        html += '<span class="result-text">' + qText + '</span>';
        if (!ar.isCorrect) {
          html += '<div class="result-answer">' + i18n.your_answer + ': ' + studentLabel + ' · ' + i18n.correct_answer + ': ' + correctLabel + '</div>';
        } else {
          html += '<div class="result-answer">' + i18n.correct_text + ': ' + correctLabel + '</div>';
        }
        html += '</div>';
      }
      html += '</div>';
    }

    resultDiv.innerHTML = html;
    form.replaceWith(resultDiv);
  }

  function showEmpty(msg) {
    document.getElementById('contentDisplay').style.display = 'none';
    var empty = document.getElementById('contentEmpty');
    empty.style.display = 'block'; empty.innerHTML = '<p>' + msg + '</p>';
  }

  function updateConnectionBar(status, text) {
    var bar = document.getElementById('connectionBar');
    bar.className = 'connection-bar ' + status; bar.textContent = text;
  }

  function updateStateBanner() {
    var banner = document.getElementById('stateBanner');
    banner.className = 'state-banner ' + currentState;
    var labels = { 'LIVE': i18n.live, 'PAUSED': i18n.paused, 'ARCHIVED': i18n.archived, 'DRAFT': i18n.waiting, 'SCHEDULED': i18n.scheduled };
    banner.textContent = labels[currentState] || currentState;
  }

  renderNav();
  if (['LIVE', 'PAUSED'].indexOf(currentState) !== -1) { document.getElementById('modeToggle').style.display = ''; setMode('sync'); }

  var btnSync = document.getElementById('btnSync');
  var btnAsync = document.getElementById('btnAsync');
  if (btnSync) btnSync.addEventListener('click', function() { setMode('sync'); });
  if (btnAsync) btnAsync.addEventListener('click', function() { setMode('async'); });
})();
</script>
<%- include('partials/footer') %>

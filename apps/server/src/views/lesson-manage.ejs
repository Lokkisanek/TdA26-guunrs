<%- include('partials/header', { title }) %>
<style>
  .badge { display: inline-block; padding: 0.15rem 0.45rem; border-radius: 4px; font-size: 0.75rem; font-weight: 700; }
  .badge-published { background: #d4edda; color: #155724; }
  .badge-draft { background: #f8d7da; color: #721c24; }
  .badge-type { background: #e9ecef; color: #555; }
  .session-item { display: flex; align-items: center; gap: 1rem; padding: 0.65rem; background: #f8f9fa; border-radius: 4px; margin-bottom: 0.5rem; flex-wrap: wrap; }
  .session-state { font-weight: 700; font-size: 0.85rem; padding: 0.2rem 0.5rem; border-radius: 4px; }
  .session-state.DRAFT { background: #e9ecef; color: #555; }
  .session-state.LIVE { background: #28a745; color: #fff; }
  .session-state.PAUSED { background: #ffc107; color: #333; }
  .session-state.ARCHIVED { background: #f8d7da; color: #721c24; }
  .session-state.SCHEDULED { background: #d4edda; color: #155724; }
</style>

<div class="container">
<a href="/dashboard" class="back-link">&larr; <%= t('back_to_dashboard') %></a>
<h1><%= lesson.title %></h1>
<p class="subtitle"><%= lang === 'en' ? 'Course' : 'Kurz' %>: <%= lesson.course.title %></p>

<!-- Add Page -->
<div class="card">
  <h2><%= t('add_page') %></h2>
  <form method="POST" action="/dashboard/lessons/<%= lesson.id %>/pages">
    <div class="form-row">
      <div class="form-group">
        <label for="pageTitle"><%= t('page_title') %> *</label>
        <input type="text" id="pageTitle" name="title" required>
      </div>
      <div class="form-group">
        <label for="pageType"><%= t('page_type') %></label>
        <select id="pageType" name="type">
          <option value="text"><%= t('text') %></option>
          <option value="video"><%= t('video') %></option>
          <option value="quiz"><%= t('quiz') %></option>
          <option value="empty_stylized"><%= t('visual_divider') %></option>
        </select>
      </div>
    </div>
    <div class="form-group">
      <label for="pageContent"><%= t('content_html') %></label>
      <textarea id="pageContent" name="content"></textarea>
    </div>
    <div class="form-group">
      <label><input type="checkbox" name="isPublished" value="true" checked> <%= t('published') %></label>
    </div>
    <button type="submit" class="btn"><%= t('add_page') %></button>
  </form>
</div>

<!-- Pages List -->
<div class="card">
  <h2><%= t('lesson_pages') %> (<%= lesson.pages.length %>)</h2>
  <% if (lesson.pages.length > 0) { %>
    <table>
      <thead><tr><th>#</th><th><%= t('title') %></th><th><%= t('page_type') %></th><th><%= t('state') %></th><th><%= t('actions') %></th></tr></thead>
      <tbody>
        <% lesson.pages.forEach(function(page, i) { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><%= page.title %></td>
            <td><span class="badge badge-type"><%= page.type %></span></td>
            <td><span class="badge <%= page.isPublished ? 'badge-published' : 'badge-draft' %>"><%= page.isPublished ? t('published') : t('draft') %></span></td>
            <td class="actions">
              <form method="POST" action="/dashboard/pages/<%= page.id %>/toggle-publish">
                <button type="submit" class="btn btn-sm btn-warning"><%= page.isPublished ? t('hide') : t('publish') %></button>
              </form>
              <form method="POST" action="/dashboard/pages/<%= page.id %>/delete" onsubmit="return confirm('<%= t('delete_page_confirm') %>');">
                <button type="submit" class="btn btn-sm btn-danger"><%= t('delete') %></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p style="color:#888;"><%= t('no_pages_yet') %></p>
  <% } %>
</div>

<!-- Live Sessions -->
<div class="card">
  <h2><%= t('live_sessions') %></h2>
  <form method="POST" action="/dashboard/lessons/<%= lesson.id %>/sessions" style="margin-bottom:1rem;">
    <button type="submit" class="btn btn-success"><%= t('create_session') %></button>
  </form>
  <% if (lesson.liveSessions && lesson.liveSessions.length > 0) { %>
    <% lesson.liveSessions.forEach(function(s) { %>
      <div class="session-item">
        <span class="session-state <%= s.currentState %>"><%= s.currentState %></span>
        <span style="font-size:0.85rem;color:#888;"><%= t('created') %>: <%= new Date(s.createdAt).toLocaleString(lang === 'en' ? 'en-US' : 'cs-CZ') %></span>
        <% if (s.currentState !== 'ARCHIVED') { %>
          <a href="/classroom/teacher/<%= s.id %>" class="btn btn-sm"><%= t('manage_live') %></a>
        <% } %>
        <a href="/classroom/student/<%= s.id %>" class="btn btn-sm btn-secondary"><%= t('student_view') %></a>
      </div>
    <% }) %>
  <% } else { %>
    <p style="color:#888;"><%= t('no_sessions') %></p>
  <% } %>
</div>
</div>

<%- include('partials/footer') %>

<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' && lang === 'en' ? 'en' : 'cs' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <%# ── SEO Meta ── %>
  <% var pageTitle = title ? title + ' | Think different Academy' : 'Think different Academy'; %>
  <% var defaultDescCS = 'Think different Academy – Interaktivní online kurzy, lekce, kvízy a živé výukové relace pro studenty i lektory.'; %>
  <% var defaultDescEN = 'Think different Academy – Interactive online courses, lectures, quizzes and live classroom sessions for students and lecturers.'; %>
  <% var desc = typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : (typeof lang !== 'undefined' && lang === 'en' ? defaultDescEN : defaultDescCS); %>
  <% var ogImage = typeof metaImage !== 'undefined' && metaImage ? metaImage : '/favicon.png'; %>
  <% var canonicalPath = typeof canonical !== 'undefined' && canonical ? canonical : ''; %>
  <% var pageType = typeof ogType !== 'undefined' && ogType ? ogType : 'website'; %>

  <title><%= pageTitle %></title>
  <meta name="description" content="<%= desc %>">
  <meta name="robots" content="<%= typeof noIndex !== 'undefined' && noIndex ? 'noindex, nofollow' : 'index, follow' %>">
  <% if (canonicalPath) { %><link rel="canonical" href="<%= canonicalPath %>">\n<% } %>

  <%# ── Open Graph ── %>
  <meta property="og:site_name" content="Think different Academy">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= desc %>">
  <meta property="og:type" content="<%= pageType %>">
  <meta property="og:image" content="<%= ogImage %>">
  <meta property="og:locale" content="<%= typeof lang !== 'undefined' && lang === 'en' ? 'en_US' : 'cs_CZ' %>">

  <%# ── Twitter Card ── %>
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= pageTitle %>">
  <meta name="twitter:description" content="<%= desc %>">
  <meta name="twitter:image" content="<%= ogImage %>">

  <%# ── Technical ── %>
  <meta name="theme-color" content="#0070BB">
  <meta name="author" content="Think different Academy">
  <meta name="generator" content="TdA LMS v2.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/favicon.png">
  <link rel="stylesheet" href="/styles.css">

  <%# ── JSON-LD Structured Data ── %>
  <% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
  <script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>
  <% } else { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Think different Academy",
    "url": "/",
    "logo": "/favicon.png",
    "description": "<%= desc.replace(/"/g, '\\"') %>",
    "sameAs": []
  }
  </script>
  <% } %>
</head>
<body>
<div class="nav-overlay" id="navOverlay"></div>
<nav class="navbar">
  <div class="nav-container">
    <div class="nav-left">
      <a href="/" class="logo">
        <img src="/img/Think-different-Academy_LOGO_bily.svg" alt="Think different Academy" class="logo-full white">
        <img src="/img/Think-different-Academy_LOGO_oficialni-bile.svg" alt="TdA" class="logo-small white">
      </a>
      <div class="nav-main">
        <a href="/"><%= typeof lang !== 'undefined' && lang === 'en' ? 'Home' : 'Domů' %></a>
        <a href="/courses"><%= typeof lang !== 'undefined' && lang === 'en' ? 'Courses' : 'Kurzy' %></a>
      </div>
    </div>

    <button class="burger" id="burgerBtn" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-links" id="navLinks">
      <div class="nav-panel-logo">
        <a href="/" class="logo-panel">
          <img src="/img/Think-different-Academy_LOGO_bily.svg" alt="Think different Academy">
        </a>
      </div>

      <div class="nav-main-mobile">
        <a href="/"><%= typeof lang !== 'undefined' && lang === 'en' ? 'Home' : 'Domů' %></a>
        <a href="/courses"><%= typeof lang !== 'undefined' && lang === 'en' ? 'Courses' : 'Kurzy' %></a>
      </div>

      <div class="nav-right">
        <div class="lang-switch">
          <a href="?lang=cs" class="lang-btn <%= typeof lang === 'undefined' || lang === 'cs' ? 'active' : '' %>" title="Čeština">CS</a>
          <a href="?lang=en" class="lang-btn <%= typeof lang !== 'undefined' && lang === 'en' ? 'active' : '' %>" title="English">EN</a>
        </div>
        <% if (user) { %>
          <% if (user.isAdmin) { %>
            <a href="/dashboard">Dashboard</a>
          <% } %>
          <a href="/profile"><%= typeof lang !== 'undefined' && lang === 'en' ? 'Profile' : 'Profil' %></a>
          <form method="post" action="/logout">
            <button type="submit"><%= typeof lang !== 'undefined' && lang === 'en' ? 'Logout' : 'Odhlásit' %></button>
          </form>
        <% } else { %>
          <a href="/login"><%= typeof lang !== 'undefined' && lang === 'en' ? 'Login' : 'Přihlásit' %></a>
          <a href="/register"><%= typeof lang !== 'undefined' && lang === 'en' ? 'Register' : 'Registrace' %></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<script>
  (function () {
    var burger = document.getElementById('burgerBtn');
    var navLinks = document.getElementById('navLinks');
    var overlay = document.getElementById('navOverlay');
    function toggleMenu() {
      if (!burger || !navLinks || !overlay) return;
      burger.classList.toggle('active');
      navLinks.classList.toggle('active');
      overlay.classList.toggle('active');
    }
    if (burger) burger.addEventListener('click', toggleMenu);
    if (overlay) overlay.addEventListener('click', toggleMenu);
  })();
</script>

<main class="main">

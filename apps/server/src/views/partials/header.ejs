<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title ? `${title} | Think different Academy` : 'Think different Academy' %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<div class="nav-overlay" id="navOverlay"></div>
<nav class="navbar">
  <div class="nav-container">
    <div class="nav-left">
      <a href="/" class="logo">
        <img src="/img/Think-different-Academy_LOGO_bily.svg" alt="Think different Academy" class="logo-full white">
        <img src="/img/Think-different-Academy_LOGO_oficialni-bile.svg" alt="TdA" class="logo-small white">
      </a>
      <div class="nav-main">
        <a href="/">Domů</a>
        <a href="/courses">Kurzy</a>
      </div>
    </div>

    <button class="burger" id="burgerBtn" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-links" id="navLinks">
      <div class="nav-panel-logo">
        <a href="/" class="logo-panel">
          <img src="/img/Think-different-Academy_LOGO_bily.svg" alt="Think different Academy">
        </a>
      </div>

      <div class="nav-main-mobile">
        <a href="/">Domů</a>
        <a href="/courses">Kurzy</a>
      </div>

      <div class="nav-right">
        <% if (user) { %>
          <a href="/dashboard">Dashboard</a>
          <form method="post" action="/logout">
            <button type="submit">Odhlásit<% if (user && user.username) { %> (<%= user.username %>)<% } %></button>
          </form>
        <% } else { %>
          <a href="/login">Přihlásit</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<script>
  (function () {
    var burger = document.getElementById('burgerBtn');
    var navLinks = document.getElementById('navLinks');
    var overlay = document.getElementById('navOverlay');
    function toggleMenu() {
      if (!burger || !navLinks || !overlay) return;
      burger.classList.toggle('active');
      navLinks.classList.toggle('active');
      overlay.classList.toggle('active');
    }
    if (burger) burger.addEventListener('click', toggleMenu);
    if (overlay) overlay.addEventListener('click', toggleMenu);
  })();
</script>

<main class="main">

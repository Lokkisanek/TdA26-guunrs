<%- include('partials/header', { title: course ? course.title : 'Kurz nenalezen' }) %>

<% if (!course) { %>
<div class="container-sm" style="text-align:center; padding-top:4rem;">
  <h1 style="color:var(--brand-blue-dark); margin-bottom:1rem;">Kurz nenalezen</h1>
  <p style="color:#555; margin-bottom:2rem;">Požadovaný kurz neexistuje nebo byl odstraněn.</p>
  <a href="/courses" class="btn">Zpět na seznam kurzů</a>
</div>
<% } else { %>
<div class="container-sm">
  <a href="/courses" class="back-link">← Zpět na seznam kurzů</a>

  <div class="course-detail">
    <h1><%= course.title %></h1>
    <p class="course-meta">ID: <%= course.id %></p>

    <div class="course-description">
      <%= course.description || course.shortDescription || 'Tento kurz zatím nemá popis.' %>
    </div>

    <!-- Lessons -->
    <% if (course.lessons && course.lessons.length > 0) { %>
    <div class="section lessons-section">
      <h2>Lekce</h2>
      <% course.lessons.forEach(function(lesson) { %>
        <div class="lesson-card">
          <h3><%= lesson.title %></h3>
          <% if (lesson.description) { %>
            <p><%= lesson.description %></p>
          <% } %>
          <div class="lesson-meta">
            <span class="pages-count"><%= lesson.pages ? lesson.pages.length : 0 %> stránek</span>
            <% if (lesson.liveSessions && lesson.liveSessions.length > 0) { %>
              <% var liveSession = lesson.liveSessions[0]; %>
              <% if (liveSession.currentState === 'LIVE') { %>
                <a href="/classroom/student/<%= liveSession.id %>" class="join-btn">🔴 Připojit se živě</a>
              <% } else if (liveSession.currentState === 'SCHEDULED') { %>
                <span style="color:#ffc107; font-weight:600;">📅 Naplánováno</span>
              <% } %>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
    <% } %>

    <!-- Feed section -->
    <div class="feed-section section">
      <h2>Informační kanál</h2>
      <% if (user) { %>
        <div class="feed-form">
          <textarea id="feed-text" placeholder="Napište zprávu pro účastníky kurzu..."></textarea>
          <button id="feed-submit">Odeslat příspěvek</button>
        </div>
      <% } %>
      <ul class="feed-list" id="feed-list">
        <li style="color:#888;font-style:italic;">Načítám kanál...</li>
      </ul>
    </div>
  </div>
</div>

<script>
  var courseId = '<%= course.id %>';
  var isUser = <%= user ? 'true' : 'false' %>;
  var feedList = document.getElementById('feed-list');

  function formatTime(iso) { return new Date(iso).toLocaleString('cs-CZ'); }
  function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function renderFeed(entries) {
    if (!entries || entries.length === 0) {
      feedList.innerHTML = '<li style="color:#888;font-style:italic;">Zatím žádné příspěvky.</li>';
      return;
    }
    feedList.innerHTML = entries.map(function(e) {
      var badgeClass = e.type === 'TEACHER' ? '' : 'autogen';
      var entryClass = e.type === 'TEACHER' ? 'teacher' : 'autogen';
      var badgeText = e.type === 'TEACHER' ? 'Lektor' : 'Systém';
      var edited = e.editedAt ? '<span class="edited">(upraveno ' + formatTime(e.editedAt) + ')</span>' : '';
      var actions = isUser ? '<div class="actions"><button onclick="editEntry(\'' + e.id + '\')">Upravit</button><button class="del" onclick="deleteEntry(\'' + e.id + '\')">Smazat</button></div>' : '';
      return '<li class="feed-entry ' + entryClass + '" data-id="' + e.id + '"><div class="meta"><span class="badge ' + badgeClass + '">' + badgeText + '</span><span>' + formatTime(e.createdAt) + '</span>' + edited + '</div><div class="content">' + escapeHtml(e.content) + '</div>' + actions + '</li>';
    }).join('');
  }

  // Initial fetch
  fetch('/api/courses/' + courseId + '/feed').then(function(r) { return r.json(); }).then(renderFeed).catch(function() {
    feedList.innerHTML = '<li style="color:#dc3545;">Chyba při načítání kanálu.</li>';
  });

  // SSE
  var evtSource = new EventSource('/api/courses/' + courseId + '/feed/stream');
  evtSource.addEventListener('init', function(e) { renderFeed(JSON.parse(e.data)); });
  ['new_entry','updated_entry','deleted_entry'].forEach(function(evt) {
    evtSource.addEventListener(evt, function() {
      fetch('/api/courses/' + courseId + '/feed').then(function(r) { return r.json(); }).then(renderFeed);
    });
  });

  // Submit
  var feedSubmitBtn = document.getElementById('feed-submit');
  if (feedSubmitBtn) {
    feedSubmitBtn.addEventListener('click', function() {
      var textarea = document.getElementById('feed-text');
      var text = textarea.value.trim();
      if (!text) return;
      fetch('/api/courses/' + courseId + '/feed', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: text })
      }).then(function(r) { if (!r.ok) throw new Error(); textarea.value = ''; }).catch(function() { alert('Nepodařilo se odeslat příspěvek'); });
    });
  }

  function editEntry(id) {
    var entryEl = feedList.querySelector('[data-id="' + id + '"]');
    if (!entryEl) return;
    var current = entryEl.querySelector('.content').textContent;
    var newText = prompt('Upravit příspěvek', current);
    if (newText === null) return;
    fetch('/api/courses/' + courseId + '/feed/' + id, {
      method: 'PATCH', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text: newText })
    }).then(function(r) { if (!r.ok) alert('Chyba při úpravě'); });
  }

  function deleteEntry(id) {
    if (!confirm('Opravdu smazat příspěvek?')) return;
    fetch('/api/courses/' + courseId + '/feed/' + id, {
      method: 'DELETE', credentials: 'same-origin'
    }).then(function(r) { if (!r.ok) alert('Chyba při mazání'); });
  }
</script>
<% } %>

<%- include('partials/footer') %>

<%- include('partials/header', { title: course ? course.title : t('course_not_found') }) %>

<% if (!course) { %>
<div class="container-sm" style="text-align:center; padding-top:4rem;">
  <h1 style="color:var(--brand-blue-dark); margin-bottom:1rem;"><%= t('course_not_found') %></h1>
  <p style="color:#555; margin-bottom:2rem;"><%= t('course_not_found_desc') %></p>
  <a href="/courses" class="btn"><%= t('back_to_courses') %></a>
</div>
<% } else { %>
<div class="container-sm">
  <a href="/courses" class="back-link">&larr; <%= t('back_to_courses') %></a>

  <div class="course-detail">
    <h1><%= course.title %></h1>
    <p class="course-meta">ID: <%= course.id %></p>

    <div class="course-description">
      <%= course.description || course.shortDescription || t('no_description_yet') %>
    </div>

    <!-- Lessons -->
    <% if (course.lessons && course.lessons.length > 0) { %>
    <div class="section lessons-section">
      <h2><%= t('lessons') %></h2>
      <% course.lessons.forEach(function(lesson) { %>
        <div class="lesson-card">
          <h3><%= lesson.title %></h3>
          <% if (lesson.description) { %>
            <p><%= lesson.description %></p>
          <% } %>
          <div class="lesson-meta">
            <span class="pages-count"><%= lesson.pages ? lesson.pages.length : 0 %> <%= t('pages') %></span>
            <% if (lesson.liveSessions && lesson.liveSessions.length > 0) { %>
              <% var liveSession = lesson.liveSessions[0]; %>
              <% if (liveSession.currentState === 'LIVE') { %>
                <a href="/classroom/student/<%= liveSession.id %>" class="join-btn">🔴 <%= t('join_live') %></a>
              <% } else if (liveSession.currentState === 'SCHEDULED') { %>
                <span style="color:#ffc107; font-weight:600;">📅 <%= t('scheduled') %></span>
              <% } %>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
    <% } %>

    <!-- Feed section -->
    <div class="feed-section section">
      <h2><%= t('feed_channel') %></h2>
      <% if (user) { %>
        <div class="feed-form">
          <textarea id="feed-text" placeholder="<%= t('write_message') %>"></textarea>
          <button id="feed-submit"><%= t('send_post') %></button>
        </div>
      <% } %>
      <ul class="feed-list" id="feed-list">
        <li style="color:#888;font-style:italic;"><%= t('loading_feed') %></li>
      </ul>
    </div>
  </div>
</div>

<script>
  var courseId = '<%= course.id %>';
  var isUser = <%= user ? 'true' : 'false' %>;
  var feedList = document.getElementById('feed-list');
  var LANG = '<%= typeof lang !== "undefined" ? lang : "cs" %>';

  var i18n = {
    no_posts: '<%= t("no_posts_yet") %>',
    feed_error: '<%= t("feed_load_error") %>',
    teacher: '<%= t("teacher") %>',
    system: '<%= t("system") %>',
    edited: '<%= t("edited") %>',
    edit: '<%= t("edit") %>',
    delete_txt: '<%= t("delete") %>',
    edit_post: '<%= t("edit_post") %>',
    delete_confirm: '<%= t("delete_post_confirm") %>',
    post_error: '<%= t("post_send_error") %>',
    edit_error: '<%= t("post_edit_error") %>',
    delete_error: '<%= t("post_delete_error") %>'
  };

  function formatTime(iso) { return new Date(iso).toLocaleString(LANG === 'en' ? 'en-US' : 'cs-CZ'); }
  function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function renderFeed(entries) {
    if (!entries || entries.length === 0) {
      feedList.innerHTML = '<li style="color:#888;font-style:italic;">' + i18n.no_posts + '</li>';
      return;
    }
    feedList.innerHTML = entries.map(function(e) {
      var badgeClass = e.type === 'TEACHER' ? '' : 'autogen';
      var entryClass = e.type === 'TEACHER' ? 'teacher' : 'autogen';
      var badgeText = e.type === 'TEACHER' ? i18n.teacher : i18n.system;
      var edited = e.editedAt ? '<span class="edited">(' + i18n.edited + ' ' + formatTime(e.editedAt) + ')</span>' : '';
      var actions = isUser ? '<div class="actions"><button onclick="editEntry(\'' + e.id + '\')">' + i18n.edit + '</button><button class="del" onclick="deleteEntry(\'' + e.id + '\')">' + i18n.delete_txt + '</button></div>' : '';
      return '<li class="feed-entry ' + entryClass + '" data-id="' + e.id + '"><div class="meta"><span class="badge ' + badgeClass + '">' + badgeText + '</span><span>' + formatTime(e.createdAt) + '</span>' + edited + '</div><div class="content">' + escapeHtml(e.content) + '</div>' + actions + '</li>';
    }).join('');
  }

  fetch('/api/courses/' + courseId + '/feed').then(function(r) { return r.json(); }).then(renderFeed).catch(function() {
    feedList.innerHTML = '<li style="color:#dc3545;">' + i18n.feed_error + '</li>';
  });

  var evtSource = new EventSource('/api/courses/' + courseId + '/feed/stream');
  evtSource.addEventListener('init', function(e) { renderFeed(JSON.parse(e.data)); });
  ['new_entry','updated_entry','deleted_entry'].forEach(function(evt) {
    evtSource.addEventListener(evt, function() {
      fetch('/api/courses/' + courseId + '/feed').then(function(r) { return r.json(); }).then(renderFeed);
    });
  });

  var feedSubmitBtn = document.getElementById('feed-submit');
  if (feedSubmitBtn) {
    feedSubmitBtn.addEventListener('click', function() {
      var textarea = document.getElementById('feed-text');
      var text = textarea.value.trim();
      if (!text) return;
      fetch('/api/courses/' + courseId + '/feed', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: text })
      }).then(function(r) { if (!r.ok) throw new Error(); textarea.value = ''; }).catch(function() { alert(i18n.post_error); });
    });
  }

  function editEntry(id) {
    var entryEl = feedList.querySelector('[data-id="' + id + '"]');
    if (!entryEl) return;
    var current = entryEl.querySelector('.content').textContent;
    var newText = prompt(i18n.edit_post, current);
    if (newText === null) return;
    fetch('/api/courses/' + courseId + '/feed/' + id, {
      method: 'PATCH', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text: newText })
    }).then(function(r) { if (!r.ok) alert(i18n.edit_error); });
  }

  function deleteEntry(id) {
    if (!confirm(i18n.delete_confirm)) return;
    fetch('/api/courses/' + courseId + '/feed/' + id, {
      method: 'DELETE', credentials: 'same-origin'
    }).then(function(r) { if (!r.ok) alert(i18n.delete_error); });
  }
</script>
<% } %>

<%- include('partials/footer') %>

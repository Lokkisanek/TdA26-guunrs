<%- include('partials/header', { title: t('courses') }) %>
<style>
  h1 { color: var(--brand-blue-dark); margin-bottom: 1.5rem; }
  .navbar { background: var(--brand-primary); }
  .visibility-badge {
    display: inline-block;
    font-size: .7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
    padding: 2px 8px;
    border-radius: 4px;
    margin-bottom: 4px;
  }
  .visibility-badge.prep   { background: #fff3cd; color: #856404; }
  .visibility-badge.live   { background: #d4edda; color: #155724; }
  .visibility-badge.closed { background: #f8d7da; color: #721c24; }
</style>

<div class="container">
  <h1><%= t('available_courses') %></h1>

  <form class="search-form" method="GET" action="/courses" id="searchForm">
    <input type="text" name="search" id="searchInput" placeholder="<%= t('search_course') %>" value="<%= search %>" autocomplete="off">
    <button type="submit"><%= t('search') %></button>
  </form>

  <div class="courses-grid" id="coursesGrid">
    <% if (courses.length > 0) { %>
      <% courses.forEach(course => { %>
        <a href="/courses/<%= course.id %>" class="course-card"
           data-name="<%= course.title.toLowerCase() %>"
           data-desc="<%= (course.shortDescription || course.description || '').toLowerCase() %>">
          <% if (user && (user.isAdmin || user.isLecturer) && course.visibility !== 'LIVE') { %>
            <span class="visibility-badge <%= course.visibility === 'PREPARATION' ? 'prep' : 'closed' %>">
              <%= course.visibility === 'PREPARATION' ? t('vis_preparation') : t('vis_closed') %>
            </span>
          <% } %>
          <h2><%= course.title %></h2>
          <p><%= course.shortDescription || course.description || t('no_description') %></p>
          <span class="card-btn"><%= t('view_detail') %></span>
        </a>
      <% }) %>
    <% } else { %>
      <div class="no-courses">
        <p><%= t('no_courses_found') %></p>
      </div>
    <% } %>
  </div>
</div>

<script>
  (function() {
    var searchInput = document.getElementById('searchInput');
    var coursesGrid = document.getElementById('coursesGrid');
    var cards = Array.from(coursesGrid.querySelectorAll('.course-card'));

    searchInput.addEventListener('input', function() {
      var query = this.value.toLowerCase().trim();

      if (!query) {
        cards.forEach(function(card) { card.style.display = ''; });
        var le = coursesGrid.querySelector('.live-search-empty');
        if (le) le.remove();
        return;
      }

      var anyVisible = false;
      cards.forEach(function(card) {
        var name = card.dataset.name || '';
        var desc = card.dataset.desc || '';
        var matches = name.includes(query) || desc.includes(query);
        card.style.display = matches ? '' : 'none';
        if (matches) anyVisible = true;
      });

      var noCoursesDiv = coursesGrid.querySelector('.live-search-empty');
      if (!anyVisible && cards.length > 0) {
        if (!noCoursesDiv) {
          var div = document.createElement('div');
          div.className = 'no-courses live-search-empty';
          div.innerHTML = '<p><%= t("no_courses_found") %></p>';
          coursesGrid.appendChild(div);
        }
      } else if (noCoursesDiv) {
        noCoursesDiv.remove();
      }
    });

    if (searchInput.value) {
      searchInput.dispatchEvent(new Event('input'));
    }
  })();
</script>

<%- include('partials/footer') %>

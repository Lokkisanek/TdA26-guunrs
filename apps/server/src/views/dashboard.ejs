<%- include('partials/header', { title: 'Dashboard' }) %>
<style>
  h1 { color: var(--brand-blue-dark); margin-bottom: 0.25rem; }
</style>

<div class="container">
  <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.5rem; margin-bottom:2rem;">
    <div>
      <h1>Dashboard</h1>
      <p class="subtitle" style="margin-bottom:0;"><%= t('manage_courses') %></p>
    </div>
    <button class="btn" id="openCreateModal" style="font-size:1rem; padding:0.7rem 1.5rem;">+ <%= t('add_new_course') %></button>
  </div>

  <% if (courses.length > 0) { %>
    <div class="courses-grid">
      <% courses.forEach(function(course) { %>
        <div class="card" style="border-top:6px solid var(--brand-primary); position:relative; padding:1.5rem;">
          <p style="font-size:0.75rem; color:#888; margin-bottom:0.5rem;">ID: <%= course.id.substring(0, 8).toUpperCase() %></p>
          <h2 style="font-size:1.3rem; color:#333; margin-bottom:0.25rem;"><%= course.title %></h2>
          <p style="color:#666; font-size:0.95rem; margin-bottom:1.25rem; line-height:1.5;"><%= course.shortDescription || '' %></p>
          <div class="actions">
            <a href="/courses/<%= course.id %>" class="btn btn-secondary btn-sm"><%= t('view') %></a>
            <a href="/dashboard/edit/courses/<%= course.id %>" class="btn btn-sm"><%= t('edit') %></a>
            <form method="POST" action="/dashboard/<%= course.id %>?_method=DELETE" onsubmit="return confirm('<%= t('delete_course_confirm') %>');" style="display:inline;">
              <button type="submit" class="btn btn-danger btn-sm"><%= t('delete') %></button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="no-courses">
      <p><%= t('no_courses_yet') %></p>
    </div>
  <% } %>
</div>

<!-- Create Course Modal -->
<div class="modal" id="createModal">
  <div class="modal-content">
    <div class="modal-header">
      <h2><%= t('add_new_course') %></h2>
      <button class="close-btn" id="closeCreateModal">&times;</button>
    </div>
    <form method="POST" action="/dashboard">
      <div class="form-group">
        <label for="title"><%= t('course_title') %> *</label>
        <input type="text" id="title" name="title" required>
      </div>
      <div class="form-group">
        <label for="shortDescription"><%= t('short_description') %></label>
        <input type="text" id="shortDescription" name="shortDescription">
      </div>
      <div class="form-group">
        <label for="description"><%= t('description') %></label>
        <textarea id="description" name="description"></textarea>
      </div>
      <div style="display:flex; gap:0.5rem; margin-top:1rem;">
        <button type="submit" class="btn"><%= t('add_course') %></button>
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('createModal').classList.remove('active')"><%= t('cancel') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Course Modal -->
<div class="modal" id="editModal">
  <div class="modal-content">
    <div class="modal-header">
      <h2><%= t('edit') %></h2>
      <button class="close-btn" id="closeEditModal">&times;</button>
    </div>
    <form method="POST" id="editForm">
      <div class="form-group">
        <label for="editTitle"><%= t('course_title') %> *</label>
        <input type="text" id="editTitle" name="title" required>
      </div>
      <div class="form-group">
        <label for="editShortDescription"><%= t('short_description') %></label>
        <input type="text" id="editShortDescription" name="shortDescription">
      </div>
      <div style="display:flex; gap:0.5rem; margin-top:1rem;">
        <button type="submit" class="btn"><%= t('save_changes') %></button>
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('editModal').classList.remove('active')"><%= t('cancel') %></button>
      </div>
    </form>
  </div>
</div>

<script>
  // Create Modal
  (function() {
    var modal = document.getElementById('createModal');
    document.getElementById('openCreateModal').addEventListener('click', function() { modal.classList.add('active'); });
    document.getElementById('closeCreateModal').addEventListener('click', function() { modal.classList.remove('active'); });
    modal.addEventListener('click', function(e) { if (e.target === modal) modal.classList.remove('active'); });
  })();

  // Edit Modal
  function openEditModal(id, title, shortDesc) {
    document.getElementById('editTitle').value = title;
    document.getElementById('editShortDescription').value = shortDesc;
    document.getElementById('editForm').action = '/dashboard/' + id + '?_method=PUT';
    document.getElementById('editModal').classList.add('active');
  }
  (function() {
    var modal = document.getElementById('editModal');
    document.getElementById('closeEditModal').addEventListener('click', function() { modal.classList.remove('active'); });
    modal.addEventListener('click', function(e) { if (e.target === modal) modal.classList.remove('active'); });
  })();
</script>

<%- include('partials/footer') %>
